pipeline {
    agent any
    stages {
        stage('Fetch secret from Vault') {
            steps {
                withCredentials([string(credentialsId: 'vault-token', variable: 'VAULT_TOKEN')]) {
                    sh '''
                        set +x
                        echo "Token in use: $VAULT_TOKEN"
                        DB_PASS=$(curl -s -H "X-Vault-Token: $VAULT_TOKEN" http://localhost:8200/v1/secret/data/app | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['data']['db_password'])")
                        echo "Secret retrieved from Vault (${#DB_PASS} characters)"
                    '''
                }
            }
        }
        stage('Deploy') {
            steps { echo 'Deploying with no secret stored in code or in the repository' }
        }
    }
}
